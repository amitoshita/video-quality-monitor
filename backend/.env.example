# Local: a SQLite file. Production: Neon's *pooled* connection string, e.g.
# postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./vqm.db

# Comma-separated exact origins of the frontend (no wildcard).
CORS_ORIGINS=http://localhost:5173

# Quality thresholds. A second is Poor when:
#   fps < MIN_FPS | brightness < MIN_BRIGHTNESS | brightness > MAX_BRIGHTNESS | motion > MAX_MOTION
MIN_FPS=15
MIN_BRIGHTNESS=60
MAX_BRIGHTNESS=200
# Calibrated on a real laptop camera: still ~0.8, fast head movement ~3.6, hand close to the
# camera > 20. Motion is a mean over the whole frame, so a head covering part of it moves the
# mean only a little. 2.0 is ~2.5x the still-noise level and below head movement.
MAX_MOTION=2.0

MAX_BATCH_SIZE=120
LOG_LEVEL=INFO
